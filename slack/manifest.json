{
  "display_information": {
    "name": "Knowledge Hub",
    "description": "Answers Ramos James Law questions from the Knowledge Hub and points to the source articles.",
    "background_color": "#0b2341"
  },
  "features": {
    "bot_user": {
      "display_name": "Knowledge Hub",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/knowledge",
        "url": "https://YOUR-HUB-DOMAIN/api/slack/commands",
        "description": "Ask the Knowledge Hub a question",
        "usage_hint": "how do we name PI intake files?",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["mcp:connect", "app_mentions:read", "chat:write", "commands"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR-HUB-DOMAIN/api/slack/events",
      "bot_events": ["app_mention"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  },
  "mcp_servers": {
    "knowledge_hub": {
      "url": "https://YOUR-HUB-DOMAIN/api/mcp",
      "auth_type": "slack_identity_auth"
    }
  }
}
