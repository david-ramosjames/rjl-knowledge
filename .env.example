# PostgreSQL connection string (Railway Postgres or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
# Optional. Defaults to text-embedding-3-small for hub search.
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: public app origin used to build the Google redirect URI.
# Example: https://rjl-knowledge-production.up.railway.app
AUTH_URL=""

# Optional access limits. If both are unset, any verified Google account can sign in.
GOOGLE_ALLOWED_DOMAIN=""
GOOGLE_ALLOWED_EMAILS=""

# Comma-separated emails that can use Admin. Everyone else can still read the hub.
ADMIN_EMAILS="david@ramosjames.com"

# Dropbox OAuth (same keys as the firm Dropbox integration). The hub
# refreshes a short-lived access token; it does not need DROPBOX_ACCESS_TOKEN.
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
DROPBOX_REFRESH_TOKEN=""
DROPBOX_NAMESPACE_ID=""
DROPBOX_CASES_ROOT=""
# Optional. Not used for the one-time backfill importer.
DROPBOX_SYNC_INTERVAL_MINUTES=""
# Optional override if you have a long-lived token instead of a refresh token.
DROPBOX_ACCESS_TOKEN=""

# Cookie signing secret. Falls back to GOOGLE_CLIENT_SECRET if unset.
AUTH_SECRET=""

# Optional local/dev password login if Google is not configured.
AUTH_PASSWORD=""
