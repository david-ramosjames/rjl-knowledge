# PostgreSQL connection string (Railway Postgres or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Optional shared password for this internal app.
# If unset, the app is open (useful for first local setup).
AUTH_PASSWORD=""

# Optional cookie-signing secret. Defaults to AUTH_PASSWORD if unset.
AUTH_SECRET=""
