# PostgreSQL connection string (Railway Postgres or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: public app origin used to build the Google redirect URI.
# Example: https://rjl-knowledge-production.up.railway.app
AUTH_URL=""

# Optional access limits. If both are unset, any verified Google account can sign in.
GOOGLE_ALLOWED_DOMAIN=""
GOOGLE_ALLOWED_EMAILS=""

# Cookie signing secret. Falls back to GOOGLE_CLIENT_SECRET if unset.
AUTH_SECRET=""

# Optional local/dev password login if Google is not configured.
AUTH_PASSWORD=""
